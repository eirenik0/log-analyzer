{
  "version": 1,
  "workflows": [
    {
      "id": "failure-triage",
      "question": "What failed, and can the supplied capture establish why?",
      "steps": [
        {
          "id": "scope",
          "args": [
            "--profile",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "info",
            "{root}/examples/investigations/failure.jsonl"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "validation",
          "args": [
            "--profile",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "profile",
            "validate",
            "{root}/examples/investigations/failure.jsonl",
            "--kind",
            "request",
            "--expected",
            "{root}/examples/investigations/failure.expected.json"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "errors",
          "args": [
            "--profile",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "errors",
            "{root}/examples/investigations/failure.jsonl"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "discovery",
          "args": [
            "--profile",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "trace",
            "{root}/examples/investigations/failure.jsonl",
            "--id",
            "request-7"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "timing",
          "args": [
            "--profile",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "perf",
            "{root}/examples/investigations/failure.jsonl",
            "--op-type",
            "request"
          ],
          "exit": 0,
          "checks": []
        }
      ],
      "skill_example": ".agents/skills/analyze-logs/examples/debug-failure.md",
      "skill_steps": [
        [
          "--profile",
          "examples/investigations/profile.toml",
          "--report-max-items",
          "5",
          "investigate",
          "examples/investigations/failure.jsonl",
          "--artifact",
          "/tmp/failure-evidence-UNIQUE.json"
        ],
        [
          "evidence",
          "/tmp/failure-evidence-UNIQUE.json",
          "--expected-sha256",
          "REPORT_ARTIFACT_SHA256",
          "--collection",
          "/findings",
          "--report-max-items",
          "5"
        ],
        [
          "evidence",
          "/tmp/failure-evidence-UNIQUE.json",
          "--expected-sha256",
          "REPORT_ARTIFACT_SHA256",
          "--collection",
          "/records",
          "--report-max-items",
          "5"
        ]
      ]
    },
