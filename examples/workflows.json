    {
      "id": "budget-stop",
      "question": "What can be concluded within a zero-item detail budget?",
      "expected_stop": "item_limit_zero",
      "steps": [
        {
          "id": "scope",
          "args": [
            "--config",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
