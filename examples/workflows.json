{
  "version": 1,
  "workflows": [
    {
      "id": "failure-triage",
      "question": "What failed, and can the supplied capture establish why?",
      "steps": [
        {
          "id": "scope",
          "args": [
            "--config",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "info",
            "{root}/examples/investigations/failure.jsonl"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "validation",
          "args": [
            "--config",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "validate-profile",
            "{root}/examples/investigations/failure.jsonl",
            "--kind",
            "request",
            "--expected",
            "{root}/examples/investigations/failure.expected.json"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "errors",
          "args": [
            "--config",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "errors",
            "{root}/examples/investigations/failure.jsonl"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "discovery",
          "args": [
            "--config",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "trace",
            "{root}/examples/investigations/failure.jsonl",
            "--id",
            "request-7"
          ],
          "exit": 0,
          "checks": []
        },
        {
          "id": "timing",
          "args": [
            "--config",
            "{root}/examples/investigations/profile.toml",
            "--report-max-items",
            "3",
            "perf",
            "{root}/examples/investigations/failure.jsonl",
            "--op-type",
            "request"
          ],
          "exit": 0,
          "checks": []
        }
      ]
    },
