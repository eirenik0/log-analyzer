        }
      ]
    },
    {
      "id": "tool-budget-stop",
      "question": "What can be concluded when one page exhausts the tool-call allowance?",
      "budgets": {
        "max_calls": 1
      },
      "expected_stop": "tool_call_or_output_budget",
      "steps": [
        {
          "id": "scope",
