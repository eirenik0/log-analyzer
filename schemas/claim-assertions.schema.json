{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot claim assertions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "required_claim_ids",
    "claims"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "required_claim_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "pointer",
              "equals"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "fact"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "equals": {},
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "pointer",
              "expected_ms"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "interval"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "expected_ms": {
                "type": "number",
                "minimum": 0
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "snapshot_id",
                  "input_ordinal",
                  "source",
                  "target"
                ],
                "properties": {
                  "snapshot_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input_ordinal": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "scope_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "root": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "identity": {
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "event_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": "object"
                  },
                  "target": {
                    "type": "object"
                  },
                  "start_operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "end_operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "finding_id",
              "step_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "link"
              },
              "finding_id": {
                "type": "string"
              },
              "step_id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "snapshot_id",
                  "input_ordinal",
                  "source",
                  "target"
                ],
                "properties": {
                  "snapshot_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input_ordinal": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "scope_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "root": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "identity": {
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "event_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": "object"
                  },
                  "target": {
                    "type": "object"
                  },
                  "start_operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "end_operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "finding_id",
              "step_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "absence"
              },
              "finding_id": {
                "type": "string"
              },
              "step_id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "pointer",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "distinct_records"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "expected": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "operation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    },
    "final_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_claim_ids",
        "finding_claim_ids",
        "checks"
      ],
      "properties": {
        "summary_claim_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_claim_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "event_subjects",
              "duration_endpoints_and_units",
              "operation_types_and_count_semantics",
              "terminal_later_cached_contrary",
              "summary_consistency",
              "causal_support"
            ]
          }
        },
        "unresolved_question_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fact",
              "interval",
              "link",
              "distinct_records"
            ]
          },
          "finding_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "start_operation": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "end_operation": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "population": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "operation": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "name"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "equals"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "equals": {}
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "interval"
                }
              }
            },
            "then": {
              "required": [
                "finding_id",
                "start_operation",
                "end_operation"
              ],
              "properties": {
                "finding_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_operation": {
                  "type": "string",
                  "minLength": 1
                },
                "end_operation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "distinct_records"
                }
              }
            },
            "then": {
              "required": [
                "population"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "link"
                }
              }
            },
            "then": {
              "required": [
                "finding_id",
                "step_id"
              ],
              "properties": {
                "finding_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "claims": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "unresolved",
        "requirements"
      ],
      "properties": {
        "unresolved": {
          "minItems": 1
        },
        "requirements": {
          "minItems": 1
        }
      }
    }
  ]
}
