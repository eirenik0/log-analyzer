{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investigation decision brief version 1",
  "type": "object",
  "properties": {
    "brief_version": {
      "const": 1
    },
    "build": {
      "type": "object",
      "properties": {
        "package_version": {
          "type": "string"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_state": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      },
      "required": [
        "package_version",
        "source_revision",
        "source_state"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "explicit",
            "selected",
            "ambiguous",
            "no_match",
            "insufficient_evidence",
            "budget_stopped"
          ]
        },
        "identity_omitted": {
          "type": "boolean"
        },
        "profile": {
          "type": "string"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project_root": {
          "type": "string"
        },
        "origins": {
          "type": "array"
        },
        "discovery": {
          "type": [
            "object",
            "null"
          ]
        },
        "samples": {
          "type": [
            "array",
            "null"
          ]
        },
        "matching_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "string"
              },
              "profile_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "analysis_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "profile",
              "profile_sha256",
              "analysis_sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "identity_omitted",
        "discovery",
        "samples",
        "matching_candidates"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "snapshot_id",
        "profile_sha256",
        "query_sha256"
      ],
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "stop": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "stop"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input_ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "capture": {
            "enum": [
              "unread",
              "prefix",
              "complete"
            ]
          },
          "consumed_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "remaining_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "coverage": {
            "type": [
              "object",
              "null"
            ]
          },
          "selected_entries": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "input_ordinal",
          "capture",
          "consumed_bytes",
          "remaining_bytes",
          "coverage",
          "selected_entries"
        ],
        "additionalProperties": false
      }
    },
    "upstream_completeness": {
      "const": "unknown"
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope_id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scope_id",
          "goal",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "stored_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "enum": [
            "original",
            "redacted",
            "unavailable"
          ]
        }
      },
      "required": [
        "status",
        "location",
        "stored_sha256",
        "content"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "displayed": {
          "type": "integer",
          "minimum": 0
        },
        "collection": {
          "const": "/findings"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "total",
        "displayed",
        "collection",
        "items"
      ],
      "additionalProperties": false
    },
    "guidance": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "enum": [
            "artifact_unavailable",
            "partial_processing",
            "needs_profile_resolution",
            "inspect_evidence"
          ]
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "artifact_unavailable",
                  "processing_stopped",
                  "repair_discovery",
                  "resolve_profile",
                  "inspect_mappings",
                  "retrieve_findings",
                  "verify_terminal_evidence",
                  "inspect_goal_support"
                ]
              },
              "reason": {
                "type": "string"
              },
              "argv": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "required_inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "reason",
              "argv",
              "required_inputs"
            ],
            "additionalProperties": false
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "version",
        "status",
        "next_actions",
        "principles"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "mandatory_metadata_over_budget"
          ]
        },
        "budget_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "budget_characters": {
          "type": [
            "integer",
            "null"
          ]
        },
        "serialized_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "serialized_characters": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "budget_bytes",
        "budget_characters",
        "serialized_bytes",
        "serialized_characters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "brief_version",
    "build",
    "profile",
    "binding",
    "processing",
    "coverage",
    "upstream_completeness",
    "assessments",
    "artifact",
    "findings",
    "guidance",
    "presentation"
  ],
  "additionalProperties": false
}
