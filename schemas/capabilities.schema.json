{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Log Analyzer capabilities",
  "type": "object",
  "required": [
    "schema_version",
    "build",
    "commands",
    "output_formats",
    "parser_formats",
    "presets",
    "event_classification",
    "report_schemas",
    "bounded_reports"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build": {
      "type": "object",
      "properties": {
        "package_version": {
          "type": "string"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_state": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      },
      "required": [
        "package_version",
        "source_revision",
        "source_state"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parser_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_classification": {
      "type": "object"
    },
    "report_schemas": {
      "type": "object",
      "properties": {
        "report": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          }
        },
        "investigation": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          }
        },
        "evidence_contract_version": {
          "const": 1
        }
      },
      "required": [
        "report",
        "capabilities",
        "investigation",
        "evidence_contract_version"
      ]
    },
    "bounded_reports": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "format": {
          "const": "compact_json"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget_units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_page_items": {
          "const": 100
        },
        "complete_flag": {
          "const": "--complete-output"
        }
      },
      "required": [
        "version",
        "format",
        "commands",
        "budget_units",
        "default_page_items",
        "cursor_binding",
        "source_records",
        "metadata_over_budget",
        "atomic_oversized_item",
        "complete_flag"
      ]
    }
  }
}
