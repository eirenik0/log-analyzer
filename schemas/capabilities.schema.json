{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Log Analyzer capabilities",
  "type": "object",
  "required": [
    "schema_version",
    "build",
    "commands",
    "output_formats",
    "parser_formats",
    "presets",
    "event_classification",
    "report_schemas",
    "bounded_reports",
    "profile_validation",
    "investigation_contracts",
    "profile_preparation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build": {
      "type": "object",
      "properties": {
        "package_version": {
          "type": "string"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_state": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      },
      "required": [
        "package_version",
        "source_revision",
        "source_state"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parser_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_classification": {
      "type": "object"
    },
    "report_schemas": {
      "type": "object",
      "properties": {
        "report": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          }
        },
        "investigation": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          }
        },
        "evidence_contract_version": {
          "const": 1
        },
        "profile_expectations": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ]
        },
        "evidence_artifact": {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          }
        },
        "investigation_contract_versions": {
          "const": [
            1
          ]
        }
      },
      "required": [
        "report",
        "capabilities",
        "investigation",
        "evidence_contract_version",
        "profile_expectations",
        "evidence_artifact",
        "investigation_contract_versions"
      ]
    },
    "bounded_reports": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "format": {
          "const": "compact_json"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget_units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_page_items": {
          "const": 100
        },
        "complete_flag": {
          "const": "--complete-output"
        }
      },
      "required": [
        "version",
        "format",
        "commands",
        "budget_units",
        "default_page_items",
        "cursor_binding",
        "source_records",
        "metadata_over_budget",
        "atomic_oversized_item",
        "complete_flag"
      ]
    },
    "profile_validation": {
      "type": "object",
      "required": [
        "version",
        "command",
        "purposes",
        "statuses",
        "expected_facts_schema",
        "candidate_activation",
        "success_exit"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "command": {
          "const": "validate-profile"
        },
        "candidate_activation": {
          "const": false
        }
      }
    },
    "investigation_contracts": {
      "type": "object",
      "properties": {
        "versions": {
          "const": [
            1
          ]
        },
        "artifact_version": {
          "const": 1
        },
        "command_available": {
          "const": true
        },
        "artifact_retrieval_available": {
          "const": true
        },
        "schemas": {
          "const": {
            "1": "investigation",
            "artifact": "evidence_artifact"
          }
        },
        "occurrence_identity": {
          "const": [
            "snapshot_id",
            "input_ordinal",
            "reference_id"
          ]
        },
        "profile_detection": {
          "const": {
            "default": true,
            "method": "unique_builtin_lifecycle_grammar",
            "overrides": [
              "config",
              "preset"
            ]
          }
        }
      },
      "required": [
        "versions",
        "artifact_version",
        "command_available",
        "artifact_retrieval_available",
        "schemas",
        "occurrence_identity"
      ],
      "additionalProperties": false
    },
    "profile_preparation": {
      "type": "object",
      "required": [
        "version",
        "command",
        "candidate_activation",
        "candidate_overwrite",
        "validation",
        "retries",
        "presentation",
        "common_cursors"
      ]
    }
  }
}
