{
  "version": 1,
  "cases": [
    {
      "id": "parse-classic",
      "description": "Recognize classic entries without rejected candidates",
      "tags": [
        "parsing",
        "classic"
      ],
      "args": [
        "-j",
        "info",
        "{fixtures}/classic.log"
      ],
      "expect": [
        {
          "id": "exit",
          "target": "exit",
          "op": "eq",
          "value": 0
        },
        {
          "id": "entries",
          "target": "json",
          "op": "eq",
          "value": 2,
          "path": "/coverage/parsed_entries"
        },
        {
          "id": "parser",
          "target": "json",
          "op": "eq",
          "value": "classic",
          "path": "/coverage/files/0/selected_parser"
        },
        {
          "id": "rejects",
          "target": "json",
          "op": "eq",
          "value": 0,
          "path": "/coverage/files/0/rejected_candidates"
        }
      ]
    },
