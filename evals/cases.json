    {
      "id": "perf-control",
      "description": "Distinct IDs pair correctly and an unfinished request remains an orphan",
      "tags": [
        "timing"
      ],
      "args": [
        "--preset",
        "service-api",
        "-j",
        "perf",
        "{fixtures}/requests.log"
      ],
      "expect": [
        {
          "id": "exit",
          "target": "exit",
          "op": "eq",
          "value": 0
        },
        {
          "id": "operations",
          "target": "json",
          "op": "length",
          "value": 2,
          "path": "/operations"
        },
        {
          "id": "slow",
          "target": "json",
          "op": "eq",
          "value": 2000,
          "path": "/operations/0/duration_ms"
        },
        {
          "id": "fast",
          "target": "json",
          "op": "eq",
          "value": 10,
          "path": "/operations/1/duration_ms"
        },
        {
          "id": "orphans",
          "target": "json",
          "op": "length",
          "value": 1,
          "path": "/orphans"
        }
      ]
    },
